  title = {Targeting {{Sedentary Behavior}} in {{Minority Populations}} as a {{Feasible Health Strategy}} during and beyond {{COVID-19}}: {{On Behalf}} of {{ACSM-EIM}} and {{HL-PIVOT}}},
  author = {Lassalle, {\relax PP} and Meyer, {\relax ML} and Conners, R and Zieff, G and Rojas, J and Faghy, {\relax MA} and Arena, R and Vermeesch, A and Joseph, {\relax RP} and Stoner, L},
